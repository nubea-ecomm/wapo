---
interface Props {
  name:
    | 'overview'
    | 'chats'
    | 'contacts'
    | 'templates'
    | 'key'
    | 'webhook'
    | 'activity'
    | 'plug'
    | 'sliders'
    | 'settings'
    | 'book'
    | 'chevron'
    | 'selector'
    | 'arrow'
}
const { name } = Astro.props
---

<svg
  class="dashboard-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'overview' && (
      <>
        <>
          <rect
            x="3"
            y="3"
            width="7"
            height="9"
            rx="1"
          />
          <rect
            x="14"
            y="3"
            width="7"
            height="5"
            rx="1"
          />
          <rect
            x="14"
            y="12"
            width="7"
            height="9"
            rx="1"
          />
          <rect
            x="3"
            y="16"
            width="7"
            height="5"
            rx="1"
          />
        </>
      </>
    )
  }
  {
    name === 'chats' && (
      <>
        <>
          <path d="M16 3H5a2 2 0 0 0-2 2v11l4-4h9a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Z" />
          <path d="M8 16v1a2 2 0 0 0 2 2h7l4 3V10a2 2 0 0 0-2-2" />
        </>
      </>
    )
  }
  {
    name === 'contacts' && (
      <>
        <>
          <path d="M16 2v2M8 2v2M3 9h2M3 15h2" />
          <rect
            x="5"
            y="4"
            width="16"
            height="18"
            rx="2"
          />
          <circle
            cx="13"
            cy="11"
            r="3"
          />
          <path d="M8 22v-2a5 5 0 0 1 10 0v2" />
        </>
      </>
    )
  }
  {
    name === 'templates' && (
      <>
        <>
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
          <path d="M14 2v6h6M8 13h8M8 17h6" />
        </>
      </>
    )
  }
  {
    name === 'key' && (
      <>
        <>
          <circle
            cx="16"
            cy="8"
            r="5"
          />
          <path d="m12.5 11.5-9 9H2v-4l9-9M6 16l2 2M16 8h.01" />
        </>
      </>
    )
  }
  {
    name === 'webhook' && (
      <>
        <>
          <path d="m13 9 4 7M7 16l4-7M7 16h10" />
          <path d="M15.5 6a3.5 3.5 0 1 0-7 0M5 12a4 4 0 1 0 6 5M19 12a4 4 0 1 1-6 5" />
        </>
      </>
    )
  }
  {name === 'activity' && <path d="M2 12h4l3-9 6 18 3-9h4" />}
  {
    name === 'plug' && (
      <>
        <path d="M9 3v5M15 3v5M7 8h10v5a5 5 0 0 1-10 0ZM12 18v4" />
      </>
    )
  }
  {
    name === 'sliders' && (
      <>
        <path d="M3 6h4m4 0h10M3 12h10m4 0h4M3 18h4m4 0h10M7 3v6M17 9v6M7 15v6" />
      </>
    )
  }
  {
    name === 'settings' && (
      <>
        <>
          <path d="M3 6h8m4 0h6M3 18h2m4 0h12" />
          <circle
            cx="13"
            cy="6"
            r="2"
          />
          <circle
            cx="7"
            cy="18"
            r="2"
          />
        </>
      </>
    )
  }
  {
    name === 'book' && (
      <>
        <path d="M12 7v14M12 7C9 4 5 4 2 5v15c4-1 7-1 10 1 3-2 6-2 10-1V5c-3-1-7-1-10 2Z" />
      </>
    )
  }
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'selector' && <path d="m8 9 4-4 4 4m-8 6 4 4 4-4" />}
  {name === 'arrow' && <path d="M7 17 17 7M7 7h10v10" />}
</svg>
