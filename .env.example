# Generate secrets with: make secrets
BOOTSTRAP_API_KEY=
BOOTSTRAP_PROJECT_ID=default
ENCRYPTION_KEY=
POSTGRES_PASSWORD=wapo-local-only
DATABASE_URL=postgres://wapo:wapo-local-only@localhost:54329/wapo?sslmode=disable
PUBLIC_URL=http://localhost:8080
# Comma-separated exact origins. Local HTTP loopback aliases on the same port are accepted.
WEB_ORIGIN=http://localhost:5173
# Optional Meta integration; numbers are registered via POST /v1/connections.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
# Optional transitional compatibility mode, scoped to exactly one project.
UPSTREAM_API_KEY=
UPSTREAM_BRIDGE_PROJECT_ID=default
UPSTREAM_PLATFORM_URL=https://provider.example/platform/v1
UPSTREAM_WHATSAPP_URL=https://provider.example/meta/whatsapp
# Local tests only. Never enable for a public multi-tenant deployment.
ALLOW_PRIVATE_WEBHOOKS=false
# Standalone Embedded Signup (dedicated numbers and WhatsApp Business App Coexistence).
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Separate operator credential for global tenant/key management.
ADMIN_API_KEY=
# Optional first administrator. Created once; changing this password later does not reset the account.
ADMIN_EMAIL=admin@wapo.local
ADMIN_PASSWORD=

# Public API address used by the console (Vite / dashboard build). Never put secrets in VITE_* variables.
VITE_API_URL=http://localhost:8080
