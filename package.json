{
  "name": "wapo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --filter @wapo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test:sdk": "node --test packages/sdk/test/*.test.mjs",
    "test:contract": "node --test scripts/upstream-contract.test.mjs",
    "test:openapi": "node scripts/check-openapi.mjs",
    "test:migrations": "node --test scripts/check-migrations.test.mjs && node scripts/check-migrations.mjs",
    "test:sdk-release": "node --test scripts/check-sdk-release.test.mjs && node scripts/check-sdk-release.mjs",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:web": "pnpm --filter @wapo/web test",
    "test": "pnpm --filter @nubea-ecomm/wapo-sdk build && pnpm test:sdk && pnpm test:sdk-release && pnpm test:web && pnpm test:openapi && pnpm test:migrations",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-docs-assets.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@scalar/api-reference": "1.75.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
